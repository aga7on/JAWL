{
  "version": 1,
  "name": "jawl-coding-capabilities",
  "description": "Deterministic regression gate for the repository coding agent substrate.",
  "minimum_capability_pass_rate": 1.0,
  "capabilities": [
    {
      "id": "bounded_context_navigation",
      "description": "Repository map, search, and numbered reads stay precise and bounded.",
      "tests": [
        "tests/integration/src/l2/host/os/skills/test_integration_files.py::test_read_file_range_returns_numbered_bounded_lines_and_checksum",
        "tests/integration/src/l2/host/os/skills/test_integration_files_search_meta.py::test_repository_search_enforces_serialized_output_budget",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_context.py::test_repository_map_enforces_serialized_character_budget",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_context.py::test_locate_code_symbol_uses_python_ast_and_prioritizes_definitions",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_context.py::test_locate_code_symbol_labels_lexical_fallback_and_bounds_output",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_context.py::test_locate_code_symbol_uses_available_tree_sitter_parser",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_lsp.py::test_lsp_resolves_project_definition_and_normalizes_utf16_column",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_lsp.py::test_lsp_unavailable_retains_syntax_aware_fallback",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_lsp.py::test_lsp_framing_rejects_oversized_payload_before_reading_body",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_lsp.py::test_lsp_acknowledges_server_request_while_waiting_for_response",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_lsp.py::test_lsp_real_stdio_process_round_trip",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_dependencies.py::test_dependency_slice_resolves_python_imports_by_direction_and_depth",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_dependencies.py::test_dependency_slice_resolves_relative_typescript_and_local_include"
      ]
    },
    {
      "id": "checked_atomic_editing",
      "description": "Edits reject stale or ambiguous state and checkpoints cannot clobber newer work.",
      "tests": [
        "tests/integration/src/l2/host/os/skills/test_integration_files.py::test_safe_file_patch_rejects_ambiguous_or_stale_edits",
        "tests/integration/src/l2/host/os/skills/test_integration_files.py::test_checkpoint_restore_refuses_to_overwrite_newer_changes"
      ]
    },
    {
      "id": "deterministic_action_orchestration",
      "description": "Dependencies and shared resource locks determine action ordering.",
      "tests": [
        "tests/unit/l3/skills/test_action_execution.py::test_dependencies_control_execution_order",
        "tests/unit/l3/skills/test_action_execution.py::test_resource_locks_are_shared_across_concurrent_plans"
      ]
    },
    {
      "id": "durable_interruption_recovery",
      "description": "Lifecycle evidence is redacted and unfinished work is classified after restart.",
      "tests": [
        "tests/unit/l3/skills/test_action_execution.py::test_durable_journal_records_plan_lifecycle_and_redacts_secrets",
        "tests/unit/l3/skills/test_action_execution.py::test_new_session_identifies_unfinished_plan_as_interrupted"
      ]
    },
    {
      "id": "task_workspace_isolation",
      "description": "Concurrent coding tasks receive independent persistent Git worktrees.",
      "tests": [
        "tests/integration/src/l2/host/os/skills/test_integration_coding_workspaces.py::test_parallel_tasks_receive_independent_worktrees",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_files.py::test_task_scoped_files_read_search_and_patch_without_workspace_path",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_files.py::test_task_scoped_files_reject_workspace_escape"
      ]
    },
    {
      "id": "bounded_diff_review",
      "description": "Diff review paginates files, bounds untracked input, and redacts credentials.",
      "tests": [
        "tests/integration/src/l2/host/os/skills/test_integration_coding_workspaces.py::test_workspace_diff_includes_untracked_redacts_secrets_and_bounds_output",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_workspaces.py::test_untracked_diff_preview_reads_with_hard_bound",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_workspaces.py::test_workspace_diff_paginates_changed_files",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_workspaces.py::test_workspace_diff_bounds_tracked_git_output_during_collection"
      ]
    },
    {
      "id": "verified_state_commit_gate",
      "description": "Only the exact successfully verified workspace fingerprint can be committed.",
      "tests": [
        "tests/integration/src/l2/host/os/skills/test_integration_coding_workspaces.py::test_commit_requires_verification_of_exact_workspace_state",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_workspaces.py::test_verification_detects_workspace_change_during_checks",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_workspaces.py::test_repository_verification_policy_selects_only_allowlisted_profiles"
      ]
    },
    {
      "id": "protocol_failure_observability",
      "description": "Multiple tool calls survive transport and failed or exhausted ReAct steps leave durable evidence.",
      "tests": [
        "tests/unit/l3/llm/test_executor.py::test_executor_merges_multiple_execute_skill_tool_calls",
        "tests/unit/l3/react/test_react_loop.py::test_react_protocol_error_is_persisted_before_retry",
        "tests/unit/l3/react/test_react_loop.py::test_react_max_steps_limit"
      ]
    },
    {
      "id": "dual_tool_transport",
      "description": "Wrapper compatibility and typed native/hybrid skill calls share one validation and execution path.",
      "tests": [
        "tests/unit/l3/skills/test_skills_registry.py::test_native_schema_is_reversible_typed_and_hybrid_compatible",
        "tests/unit/l3/skills/test_skills_registry.py::test_native_schema_enforces_selection_limit",
        "tests/unit/l3/skills/test_skills_registry.py::test_guard_resolves_deferred_annotations_from_wrapped_skill_globals",
        "tests/unit/l3/llm/test_executor.py::test_executor_converts_native_tool_call_and_plain_completion",
        "tests/unit/l3/react/test_react_loop.py::test_react_executes_resolved_native_tool_and_dynamic_schema"
      ]
    },
    {
      "id": "durable_coding_plan",
      "description": "Task plans persist dependency state and evidence, reject stale writers, and gate final commits.",
      "tests": [
        "tests/integration/src/l2/host/os/skills/test_integration_coding_plans.py::test_coding_plan_persists_dependencies_evidence_and_commit_gate",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_plans.py::test_coding_plan_rejects_cycles_and_redacts_evidence"
      ]
    },
    {
      "id": "cross_layer_trace_correlation",
      "description": "Async trace IDs survive child tasks, cancellation, actions, verification, and commits without leaking contexts.",
      "tests": [
        "tests/unit/utils/test_tracing.py::test_trace_context_is_inherited_by_child_tasks_and_reset",
        "tests/unit/l3/skills/test_action_execution.py::test_action_journal_correlates_trace_and_task_id",
        "tests/unit/l3/react/test_react_loop.py::test_react_cancellation_persists_terminal_tick",
        "tests/integration/src/l2/host/os/skills/test_integration_coding_plans.py::test_coding_plan_persists_dependencies_evidence_and_commit_gate"
      ]
    },
    {
      "id": "fixed_patch_quality_eval",
      "description": "Fixed repositories grade public and hidden correctness, scope precision, and patch economy.",
      "tests": [
        "tests/integration/benchmarks/test_coding_task_eval.py::test_reference_patches_pass_public_hidden_scope_and_economy_gates",
        "tests/integration/benchmarks/test_coding_task_eval.py::test_candidate_cannot_hide_an_untracked_file_from_scope_gate",
        "tests/integration/benchmarks/test_coding_task_eval.py::test_live_driver_prompt_exposes_contract_but_not_hidden_oracle",
        "tests/integration/benchmarks/test_coding_task_eval.py::test_live_driver_extracts_committed_workspace_patch_for_same_grader",
        "tests/integration/benchmarks/test_coding_task_eval.py::test_live_driver_runs_real_react_and_coding_skills_without_network"
      ]
    }
  ]
}
